# Copy to .env.local for local dev. On Railway, set these in the project's
# Variables tab — both services (web + agent) share them.

# ── App ──────────────────────────────────────────────────────────────────
# Local: http://localhost:3000
# Railway: ${{web.RAILWAY_PUBLIC_DOMAIN}} (or use private domain for service-to-service)
APP_URL=http://localhost:3000

# ── Database (Railway Postgres plugin auto-injects DATABASE_URL) ─────────
DATABASE_URL=

# ── Paiement HYP (Yaad Pay-Protocol — abonnements tenant) ────────────────
# Compte marchand HYP (masof). Tamara réutilise le compte du projet
# shabespresso. ⚠️ Vérifier que le masof est activé pour l'EUR (Coin=3) si
# tu factures des clients européens — historiquement ILS-only.
HYP_TERMINAL=
HYP_KEY=
HYP_PASSP=
HYP_API_URL=https://icom.yaad.net/p/
# Tokenisation récurrente HYP (Hok Keva / HK=True) : "1" pour carte enregistrée
# + renouvellement auto. ⚠️ Laisser vide tant que le token-charge n'est pas
# vérifié sur le masof (cf. spec billing-overhaul, Phase D).
HYP_TOKENS_ENABLED=

# ── Auth.js (dashboard login) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Required in production behind a proxy (Railway, Vercel, etc.)
AUTH_TRUST_HOST=true
# Canonical URL of the deployed web service. Without this, redirects after
# login go to localhost (Railway's internal port). Set to your public URL.
AUTH_URL=http://localhost:3000

# ── Admin bootstrap (used by scripts/migrate.mjs on first deploy) ────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── OpenAI Realtime (used by web /api/session and agent worker) ─────────
OPENAI_API_KEY=
# Optional override; defaults are baked into lib/realtime.ts
# REALTIME_MODEL=gpt-realtime-mini
# REALTIME_VOICE=marin

# ── xAI / Grok (optional, only if testing Grok models in dropdown) ──────
XAI_API_KEY=
GROK_MODEL=grok-voice-think-fast-1.0

# ── LiveKit Cloud ────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Twilio (PSTN → SIP trunk → LiveKit) ─────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TRUNK_SID=

# ── WhatsApp (recap après appel) ────────────────────────────────────────
# Provider: "meta" (recommandé production, default) ou "twilio" (sandbox)
WHATSAPP_PROVIDER=meta

# ─ Meta Cloud API (graph.facebook.com) ─
# Récupérer dans Meta Business Manager → WhatsApp Manager → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Optionnel: version de l'API (default v22.0)
# WHATSAPP_API_VERSION=v22.0
# Template pour notifications proprio hors fenêtre 24h. À créer + faire approuver
# dans Meta Business Manager. Doit avoir UN paramètre body {{1}}.
# WHATSAPP_OWNER_TEMPLATE_NAME=salon_recap
# WHATSAPP_OWNER_TEMPLATE_LANG=fr

# ─ Twilio fallback (sandbox ou approved sender) ─
# Activé seulement si WHATSAPP_PROVIDER=twilio
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─ Rappel de RDV J-1 (cron /api/cron/appointment-reminders) ─
# Template Twilio Content du rappel client, par langue (UN paramètre {{1}} = texte).
# OPTIONNEL : si absent, on retombe sur WHATSAPP_CLIENT_TEMPLATE_SID_<LANG> (récap
# client déjà approuvé) → aucune nouvelle approbation Meta requise pour démarrer.
# WHATSAPP_REMINDER_TEMPLATE_SID_FR=
# WHATSAPP_REMINDER_TEMPLATE_SID_HE=
# WHATSAPP_REMINDER_TEMPLATE_SID_EN=

# ── Internal RPC secret (web ↔ agent) ───────────────────────────────────
# Random string. Agent sends it as `x-internal-secret` header when posting
# call recaps. Generate with: openssl rand -hex 32
INTERNAL_SECRET=

# Optional override for the call-summary model (default: gpt-4o-mini)
# SUMMARY_MODEL=gpt-4o-mini

# Optional override for the website-scan extraction model (default: gpt-5.4-mini)
# Used by the "Fill from my website" wizard sub-agents. Reuses OPENAI_API_KEY.
# WEBSITE_SCAN_MODEL=gpt-5.4-mini
# Optional Jina Reader API key — used to render JS sites (Wix/SPA) during the
# website scan. Works WITHOUT a key (free tier, rate-limited) ; set one for
# higher limits. https://jina.ai/reader
# JINA_API_KEY=

# ── Google APIs (Calendar + Sheets, OAuth refresh-token flow) ───────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_ID=
GOOGLE_REFRESH_TOKEN=
